clear all
clc

MGPS = readmatrix('MGPS_matrix.txt');
save('MGPS_matrix.mat','MGPS','-v7.3');

GL2 = readmatrix('GL2.txt');
save('GL2.mat','GL2','-v7.3');

EqOp1 = readmatrix('EqOp1.txt');
save('EqOp1.mat','EqOp1','-v7.3');

EqOp2 = readmatrix('EqOp2.txt');
save('EqOp2.mat','EqOp2','-v7.3');

EqOp3 = readmatrix('EqOp3.txt');
save('EqOp3.mat','EqOp3','-v7.3');

EqOp4 = readmatrix('EqOp4.txt');
save('EqOp4.mat','EqOp4','-v7.3');

EqLowOp2 = readmatrix('EqLowOp2.txt');
save('EqLowOp2.mat','EqLowOp2','-v7.3');

EqLowOp3 = readmatrix('EqLowOp3.txt');
save('EqLowOp3.mat','EqLowOp3','-v7.3');

EqLowOp4 = readmatrix('EqLowOp4.txt');
save('EqLowOp4.mat','EqLowOp4','-v7.3');

nodes_mgps = size(MGPS,1);
nodes_gl2 = size(GL2,1);
nodes_eqop1 = size(EqOp1,1);
nodes_eqop2 = size(EqOp2,1);
nodes_eqop3 = size(EqOp3,1);
nodes_eqop4 = size(EqOp4,1);
nodes_eqlowop2 = size(EqLowOp2,1);
nodes_eqlowop3 = size(EqLowOp3,1);
nodes_eqlowop4 = size(EqLowOp4,1);


%% Number of Links

links_mgps = nnz(MGPS)/2;
links_gl2 = nnz(GL2)/2;
links_eqop1 = nnz(EqOp1)/2;
links_eqop2 = nnz(EqOp2)/2;
links_eqop3 = nnz(EqOp3)/2;
links_eqop4 = nnz(EqOp4)/2;
links_eqlowop2 = nnz(EqLowOp2)/2;
links_eqlowop3 = nnz(EqLowOp3)/2;
links_eqlowop4 = nnz(EqLowOp4)/2;

minlinks_mgps = nodes_
minlinks_gl2 = nnz(GL2)/2;
minlinks_eqop1 = nnz(EqOp1)/2;
minlinks_eqop2 = nnz(EqOp2)/2;
minlinks_eqop3 = nnz(EqOp3)/2;
minlinks_eqop4 = nnz(EqOp4)/2;
minlinks_eqlowop2 = nnz(EqLowOp2)/2;
minlinks_eqlowop3 = nnz(EqLowOp3)/2;
minlinks_eqlowop4 = nnz(EqLowOp4)/2;

%% Degree per node

degree_mgps = sum(MGPS,2);
degree_gl2 = sum(GL2,2);
degree_eqop1 = sum(EqOp1,2);
degree_eqop2 = sum(EqOp2,2);
degree_eqop3 = sum(EqOp3,2);
degree_eqop4 = sum(EqOp4,2);
degree_eqlowop2 = sum(EqLowOp2,2);
degree_eqlowop3 = sum(EqLowOp3,2);
degree_eqlowop4 = sum(EqLowOp4,2);

%% Density per node

density_mgps = degree_mgps/(nodes_mgps-1);
density_gl2 = degree_mgps/(nodes_mgps-1);
density_eqop1 = degree_mgps/(nodes_mgps-1);
density_eqop2 = degree_mgps/(nodes_mgps-1);
density_eqop3 = degree_mgps/(nodes_mgps-1);
density_eqop4 = degree_mgps/(nodes_mgps-1);
density_eqlowop2 = degree_mgps/(nodes_mgps-1);
density_eqlowop3 = degree_mgps/(nodes_mgps-1);
density_eqlowop4 = degree_mgps/(nodes_mgps-1);

%% clustering

clustering_mgps = zeros(nodes_mgps,1);
clustering_gl2 = zeros(nodes_mgps,1);
clustering_eqop1 = zeros(nodes_mgps,1);
clustering_eqop2 = zeros(nodes_mgps,1);
clustering_eqop3 = zeros(nodes_mgps,1);
clustering_eqop4 = zeros(nodes_mgps,1);
clustering_eqlowop2 = zeros(nodes_mgps,1);
clustering_eqlowop3 = zeros(nodes_mgps,1);
clustering_eqlowop4 = zeros(nodes_mgps,1);


    for i_mgps = 1:nodes_mgps
        neighbors_mgps = find(MGPS(i_mgps,:) == 1);
        k_mgps = length(neighbors_mgps);

        if k_mgps <= 1
            clustering_mgps(i_mgps) = 0;
        else
            sub_mgps = MGPS(neighbors_mgps, neighbors_mgps);

            Ei_mgps = nnz(sub_mgps) / 2;

            clustering_mgps(i_mgps) = (2 * Ei_mgps) / (k_mgps * (k_mgps - 1));
        end
    end

     for i_gl2 = 1:nodes_gl2
        neighbors_gl2 = find(GL2(i_gl2,:) == 1);
        k_gl2 = length(neighbors_gl2);

        if k_gl2 <= 1
            clustering_gl2(i_gl2) = 0;
        else
            sub_gl2 = GL2(neighbors_gl2, neighbors_gl2);

            Ei_gl2 = nnz(sub_gl2) / 2;

            clustering_gl2(i_gl2) = (2 * Ei_gl2) / (k_gl2 * (k_gl2 - 1));
        end
    end


     for i_eqop1 = 1:nodes_eqop1
        neighbors_eqop1 = find(EqOp1(i_eqop1,:) == 1);
        k_eqop1 = length(neighbors_eqop1);

        if k_eqop1 <= 1
            clustering_eqop1(i_eqop1) = 0;
        else
            sub_eqop1 = EqOp1(neighbors_eqop1, neighbors_eqop1);

            Ei_eqop1 = nnz(sub_eqop1) / 2;

            clustering_eqop1(i_eqop1) = (2 * Ei_eqop1) / (k_eqop1 * (k_eqop1 - 1));
        end
    end


     for i_eqop2 = 1:nodes_eqop2
        neighbors_eqop2 = find(EqOp2(i_eqop2,:) == 1);
        k_eqop2 = length(neighbors_eqop2);

        if k_eqop2 <= 1
            clustering_eqop2(i_eqop2) = 0;
        else
            sub_eqop2 = EqOp2(neighbors_eqop2, neighbors_eqop2);

            Ei_eqop2 = nnz(sub_eqop2) / 2;

            clustering_eqop2(i_eqop2) = (2 * Ei_eqop2) / (k_eqop2 * (k_eqop2 - 1));
        end
    end

     for i_eqop3 = 1:nodes_eqop3
        neighbors_eqop3 = find(EqOp3(i_eqop3,:) == 1);
        k_eqop3 = length(neighbors_eqop3);

        if k_eqop3 <= 1
            clustering_eqop3(i_eqop3) = 0;
        else
            sub_eqop3 = EqOp3(neighbors_eqop3, neighbors_eqop3);

            Ei_eqop3 = nnz(sub_eqop3) / 2;

            clustering_eqop3(i_eqop3) = (2 * Ei_eqop3) / (k_eqop3 * (k_eqop3 - 1));
        end
    end

     for i_eqop4 = 1:nodes_eqop4
        neighbors_eqop4 = find(EqOp4(i_eqop4,:) == 1);
        k_eqop4 = length(neighbors_eqop4);

        if k_eqop4 <= 1
            clustering_eqop4(i_eqop4) = 0;
        else
            sub_eqop4 = EqOp4(neighbors_eqop4, neighbors_eqop4);

            Ei_eqop4 = nnz(sub_eqop4) / 2;

            clustering_eqop4(i_eqop4) = (2 * Ei_eqop4) / (k_eqop4 * (k_eqop4 - 1));
        end
    end

     for i_eqlowop2 = 1:nodes_eqlowop2
        neighbors_eqlowop2 = find(EqLowOp2(i_eqlowop2,:) == 1);
        k_eqlowop2 = length(neighbors_eqlowop2);

        if k_eqlowop2 <= 1
            clustering_eqlowop2(i_eqlowop2) = 0;
        else
            sub_eqlowop2 = EqLowOp2(neighbors_eqlowop2, neighbors_eqlowop2);

            Ei_eqlowop2 = nnz(sub_eqlowop2) / 2;

            clustering_eqlowop2(i_eqlowop2) = (2 * Ei_eqlowop2) / (k_eqlowop2 * (k_eqlowop2 - 1));
        end
    end

     for i_eqlowop3 = 1:nodes_eqlowop3
        neighbors_eqlowop3 = find(EqLowOp3(i_eqlowop3,:) == 1);
        k_eqlowop3 = length(neighbors_eqlowop3);

        if k_eqlowop3 <= 1
            clustering_eqlowop3(i_eqlowop3) = 0;
        else
            sub_eqlowop3 = EqLowOp3(neighbors_eqlowop3, neighbors_eqlowop3);

            Ei_eqlowop3 = nnz(sub_eqlowop3) / 2;

            clustering_eqlowop3(i_eqlowop3) = (2 * Ei_eqlowop3) / (k_eqlowop3 * (k_eqlowop3 - 1));
        end
    end

     for i_eqlowop4 = 1:nodes_eqlowop4
        neighbors_eqlowop4 = find(EqLowOp4(i_eqlowop4,:) == 1);
        k_eqlowop4 = length(neighbors_eqlowop4);

        if k_eqlowop4 <= 1
            clustering_eqlowop4(i_eqlowop4) = 0;
        else
            sub_eqlowop4 = EqLowOp4(neighbors_eqlowop4, neighbors_eqlowop4);

            Ei_eqlowop4 = nnz(sub_eqlowop4) / 2;

            clustering_eqlowop4(i_eqlowop4) = (2 * Ei_eqlowop4) / (k_eqlowop4 * (k_eqlowop4 - 1));
        end
    end

    avgclustering_mgps = mean(clustering_mgps);
    avgclustering_gl2 = mean(clustering_gl2);
    avgclustering_eqop1 = mean(clustering_eqop1);
    avgclustering_eqop2 = mean(clustering_eqop2);
    avgclustering_eqop3 = mean(clustering_eqop3);
    avgclustering_eqop4= mean(clustering_eqop4);
    avgclustering_eqlowop2= mean(clustering_eqlowop2);
    avgclustering_eqlowop3 = mean(clustering_eqlowop3);
    avgclustering_eqlowop4 = mean(clustering_eqlowop4);


%% Redundancy






